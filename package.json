{
  "name": "codex-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Destiny 2 knowledge companion: structured game data plus retrieval over patch notes and wiki prose.",
  "license": "MIT",
  "author": "Zimoo343",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sync": "node --env-file=.env.local src/server/sync/run.ts",
    "ingest": "node --env-file=.env.local src/server/rag/ingest.ts",
    "ask": "node --env-file=.env.local src/server/rag/ask.ts",
    "eval": "node --env-file=.env.local src/server/rag/eval.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
